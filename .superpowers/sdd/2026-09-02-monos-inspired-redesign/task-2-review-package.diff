+/* ==========================================================================
+   Physics Container & Value Lab
+   ========================================================================== */
+.physics-container {
+  position: relative;
+  width: 100%;
+  height: 460px;
+  border-radius: 16px;
+  border: 1px solid rgba(255, 255, 255, 0.08);
+  background: radial-gradient(circle at 50% 0%, rgba(56, 189, 248, 0.07), transparent 70%),
